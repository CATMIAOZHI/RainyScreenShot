<?xml version="1.0" encoding="utf-8"?>
<!--
    快捷磁贴图标：截屏 · 家族取景框 + 隐私徽标（v5）
    设计（v5）：
    - 背景依据：水晴实测截图（2026-09-07）——SystemUI 将磁贴图标
      单色化渲染为白色，v3 的粉/红颜色区分在系统层失效。故 v5 全部
      差异落在剪影形状上，白化后依然可辨
    - 公共隐私徽标：顶部居中「眼睛 + 斜杠」Ø4.2（外框 r=1.6 stroke 1.0、
      瞳孔 r=0.6、斜杠 1.0 贯穿圆心）——「看不见 / 隐身 / 静默」语义，
      两枚磁贴都有，系统磁贴无此元素，一眼区分「雨晴家 vs 系统」；
      含 stroke 外缘口径：顶部留白 0.5、与框臂间隙 0.2
    - 中心元素（功能区分）：草莓粉实心圆点 r=2.0（Ø4.0，快门点语义）
    - 与录屏磁贴区分：中心「小圆点 ↔ 大圆角方块」（Ø4.0 vs 8.8 见方，
      尺寸差 2.2 倍）——白化后仍一眼可分
    - 取景框：half=6.0（0.25×24，较 v3 略缩为顶部徽标腾空间）、
      arm=0.75×half=4.5、笔宽 2.2（0.092×24 抗锯齿加粗）；
      内边缘距中心 4.9，圆点与内边缘间隙 2.9
    - 颜色保留（若系统不白化）：粉框/粉眼/粉点，家族色板 #FF85A2
    - 去掉 android:tint：不经 vector 层染色，原色直出
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 隐私徽标 · 眼睛外框（stroke 圆，r=1.6 中心 12,2.6） -->
    <path
        android:pathData="M10.4,2.6 a1.6,1.6 0 1,1 3.2,0 a1.6,1.6 0 1,1 -3.2,0"
        android:strokeColor="#FF85A2"
        android:strokeWidth="1.0"
        android:strokeLineCap="round" />
    <!-- 隐私徽标 · 瞳孔（r=0.6） -->
    <path
        android:fillColor="#FF85A2"
        android:pathData="M12,2.6 m-0.6,0 a0.6,0.6 0 1,1 1.2,0 a0.6,0.6 0 1,1 -1.2,0" />
    <!-- 隐私徽标 · 斜杠（贯穿圆心，隐藏语义） -->
    <path
        android:pathData="M10.6,1.3 L13.4,3.9"
        android:strokeColor="#FF85A2"
        android:strokeWidth="1.0"
        android:strokeLineCap="round" />
    <!-- 四角 L 线 · 草莓粉 · 圆头端点（half=6.0 / arm=4.5） -->
    <path
        android:pathData="M6.0,10.5 L6.0,6.0 L10.5,6.0"
        android:strokeColor="#FF85A2"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M13.5,6.0 L18.0,6.0 L18.0,10.5"
        android:strokeColor="#FF85A2"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M6.0,13.5 L6.0,18.0 L10.5,18.0"
        android:strokeColor="#FF85A2"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M18.0,13.5 L18.0,18.0 L13.5,18.0"
        android:strokeColor="#FF85A2"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- 中心快门点 · 草莓粉实心圆 r=2.0（Ø4.0） -->
    <path
        android:fillColor="#FF85A2"
        android:pathData="M12,12m-2.0,0a2.0,2.0 0,1 1,4.0 0a2.0,2.0 0,1 1,-4.0 0" />
</vector>