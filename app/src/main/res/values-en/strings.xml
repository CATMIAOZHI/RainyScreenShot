    <!-- Home · Info card -->
    <string name="info_title">How it works</string>
    <string name="info_body">• Capture runs through Shizuku shell, not MediaProjection\n• No system dialogs, no cast icon in the status bar, no callbacks to the target app\n• Quick Settings tiles work anywhere (except on the secure lock screen)\n• Outputs are stored in private app storage; preview/share/delete on the History page</string>
