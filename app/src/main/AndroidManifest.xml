<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        RainyScreenShot 静默截屏/录屏。
        权限策略（隐身性 + 最小权限优先）：
        - 无前台服务、无通知 → 不申请 POST_NOTIFICATIONS / FGS_*
        - SYSTEM_ALERT_WINDOW 仅悬浮控制球使用（阶段 2 交付时申请）
        - Shizuku 权限通过其 Provider 声明动态请求，不占 manifest 权限位
        - 不申请任何与本项目无关的权限
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <!-- Shizuku 包探测（权限校验与版本检查） -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:name=".RainyScreenShotApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RainyScreenShot"
        tools:ignore="UnusedAttribute"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RainyScreenShot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 快捷磁贴：截屏（锁屏可用） -->
        <service
            android:name=".trigger.ScreenshotTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_screenshot"
            android:label="@string/tile_screenshot"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- 快捷磁贴：录屏开始/停止 -->
        <service
            android:name=".trigger.RecordTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_record"
            android:label="@string/tile_record"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Shizuku Provider 声明（Shizuku v3+ 必需） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- AppCompat 语言持久化服务（API<33 时 setApplicationLocales 的存取） -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- 悬浮控制球（阶段 3：常驻 overlay，点击录屏启停） -->
        <service
            android:name=".overlay.FloatingBallService"
            android:exported="false" />

        <!-- 图片/视频预览页（悬浮球入口，全屏黑底） -->
        <activity
            android:name=".ui.preview.PreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.RainyScreenShot" />

        <!-- FileProvider：历史页分享截图/录屏（App 私有目录 → content:// URI） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>